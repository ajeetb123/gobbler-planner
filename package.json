{
  "name": "gobbler-plan",
  "version": "1.0.0",
  "description": "Unofficial degree planner: roadmaps, prerequisite checks, major comparison",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "backtest": "node bench/grades.backtest.ts",
    "backtest:matters": "node bench/matters.backtest.ts",
    "eval:ask": "node bench/ask.eval.ts",
    "eval:rag": "node bench/rag.eval.ts",
    "build": "node scripts/build-site.ts",
    "build:grades": "node scripts/build-site.ts --grades",
    "pilot": "node scripts/build-site.ts --grades --top 30",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.89"
  }
}
