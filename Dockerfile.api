# Gobbler Plan API: anonymous usage counts and the owner's dashboard. Node only, no npm packages.
# Run with the site:  docker compose up --build   (see compose.yaml)
FROM node:24-alpine
WORKDIR /app
COPY package.json ./
COPY server ./server
# The database lives in /data. Mount a volume there or the counts are lost when the container is replaced.
RUN mkdir /data && chown node:node /data
USER node
ENV PORT=3000 DB_PATH=/data/gobbler.db
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:3000/api/healthz || exit 1
CMD ["node", "server/main.ts"]
